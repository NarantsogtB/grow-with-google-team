# Files to exclude from the Docker build context
# Smaller context = faster build uploads

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
coverage.xml

# Virtual environment — NEVER copy this into Docker
.venv/
venv/
env/

# Environment files — secrets must be injected via docker run -e, not baked in
.env
.env.*

# Development files
*.db
family_medical.db
tests/

# Editor files
.vscode/
.idea/
*.swp

# Git
.git/
.gitignore
